---
import StatTile from "./StatTile.astro";
// Photo 4:5 with a metadata caption, then the story. Mobile: photo first.
interface Props {
  imgSrc: string;
  captionLines: string[];
  title: string;
  paragraphs: string[];
  stats: { number: string; label: string }[];
}
const { imgSrc, captionLines, title, paragraphs, stats } = Astro.props;
---

<div class="founder">
  <div>
    <div class="media ratio-4x5 placeholder" data-label={`Image placeholder: ${imgSrc}`}>
      <img src={imgSrc} alt="Doyle Maurer on a job site" loading="lazy" />
    </div>
    <p class="meta caption">{captionLines.join(" · ")}</p>
  </div>
  <div class="founder-body">
    <h2>{title}</h2>
    <div class="prose">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="founder-stats">
      {stats.map((s) => <StatTile number={s.number} label={s.label} />)}
    </div>
  </div>
</div>

<style>
  .founder {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-block);
    align-items: start;
  }
  .media img {
    position: absolute;
    inset: 0;
  }
  .placeholder {
    position: relative;
  }
  .caption {
    margin-top: 0.75rem;
  }
  .founder-body > * + * {
    margin-top: var(--space-stack);
  }
  .founder-stats {
    display: grid;
    gap: 1rem;
    max-width: 22rem;
  }
  @media (max-width: 52rem) {
    .founder {
      grid-template-columns: 1fr;
    }
  }
</style>
