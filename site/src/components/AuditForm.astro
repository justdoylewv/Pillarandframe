---
// One component, three field sets. Works without JS as a plain POST to the
// webhook; with JS it posts JSON and redirects to /thanks. No phone field.
import { CONTACT_EMAIL } from "../lib/site.js";
interface Props { type: "commercial" | "operations" | "residential" }
const { type } = Astro.props;
const webhook = import.meta.env.PUBLIC_GHL_WEBHOOK_URL || "";

const labels = { commercial: "Send my audit", operations: "Book the call", residential: "Get my number" };
const errorCopy = `That didn't send. Try again, or email ${CONTACT_EMAIL}.`;
---

<form
  class="audit-form"
  method="POST"
  action={webhook || "#"}
  data-audit-form
  data-type={type}
  data-webhook={webhook}
  novalidate
>
  <input type="hidden" name="type" value={type} />

  {/* Honeypot. Hidden from people, present for bots. */}
  <div class="sr-only" aria-hidden="true">
    <label for={`hp-${type}`}>Leave this empty</label>
    <input id={`hp-${type}`} type="text" name="company_website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="fields">
    {type === "commercial" && (
      <>
        <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" type="text" required autocomplete="name" /></div>
        <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" type="text" required autocomplete="organization" /></div>
        <div class="field"><label for="f-website">Website</label><input id="f-website" name="website" type="text" inputmode="url" required autocomplete="url" /></div>
      </>
    )}
    {type === "operations" && (
      <>
        <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" type="text" required autocomplete="name" /></div>
        <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" type="text" required autocomplete="organization" /></div>
        <div class="field"><label for="f-project">Project type</label><input id="f-project" name="project_type" type="text" required /></div>
        <div class="field"><label for="f-updates">How do stakeholders get updates today?</label><textarea id="f-updates" name="current_updates" rows="4" required></textarea></div>
      </>
    )}
    {type === "residential" && (
      <>
        <div class="field"><label for="f-customers">Customers in your system</label><input id="f-customers" name="customers" type="number" min="0" required inputmode="numeric" /></div>
        <div class="field"><label for="f-ticket">Average tune-up ticket</label><input id="f-ticket" name="ticket" type="number" min="0" required inputmode="numeric" /></div>
        <div class="field"><label for="f-contacted">Contacted last season</label><input id="f-contacted" name="contacted" type="number" min="0" required inputmode="numeric" /></div>
        <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" type="text" required autocomplete="name" /></div>
        <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" type="text" required autocomplete="organization" /></div>
        <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
      </>
    )}
  </div>

  <p class="form-error" data-error hidden>{errorCopy}</p>

  <p><button class="btn" type="submit" data-submit>{labels[type]}</button></p>
</form>

<style>
  .audit-form {
    max-width: 36rem;
  }
  .fields {
    display: grid;
    gap: var(--space-stack);
  }
  .form-error {
    margin-top: var(--space-stack);
  }
  .audit-form > p:last-child {
    margin-top: var(--space-stack);
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-audit-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const error = form.querySelector<HTMLElement>("[data-error]");
      const button = form.querySelector<HTMLButtonElement>("[data-submit]");
      error && (error.hidden = true);

      if (!form.reportValidity()) return;

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (data.company_website) { window.location.href = `/thanks?type=${data.type}`; return; }
      delete data.company_website;

      const url = form.dataset.webhook;
      if (!url) { error && (error.hidden = false); return; }

      button && (button.disabled = true);
      try {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...data, source: location.pathname }),
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = `/thanks?type=${data.type}`;
      } catch {
        error && (error.hidden = false);
        button && (button.disabled = false);
      }
    });
  });
</script>
