---
// Three equal cards, whole card is the link. Same shape as CaseStudyCard.
interface Props { doors: { title: string; body: string; href: string }[] }
const { doors } = Astro.props;
---

<div class="doors">
  {doors.map((d) => (
    <a class="door" href={d.href}>
      <h3>{d.title}</h3>
      <p>{d.body}</p>
    </a>
  ))}
</div>

<style>
  .doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .door {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-stack);
    text-decoration: none;
  }
  .door:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .door p {
    margin-top: 0.75rem;
  }
  @media (max-width: 52rem) {
    .doors {
      grid-template-columns: 1fr;
    }
  }
</style>
