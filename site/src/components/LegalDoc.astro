---
interface Section { heading: string; blocks: (string | { list: string[] } | { note: string } | { subhead: string })[] }
interface Props { title: string; intro: string; sections: Section[]; effective: string }
const { title, intro, sections, effective } = Astro.props;
---

<article class="legal container">
  <p class="meta">Effective {effective}</p>
  <h1 class="fade-up">{title}</h1>
  <p class="prose mt">{intro}</p>
  <nav aria-label="Contents" class="toc">
    <ol>{sections.map((s, i) => <li><a href={`#s${i + 1}`}>{i + 1}. {s.heading}</a></li>)}</ol>
  </nav>
  {sections.map((s, i) => (
    <section id={`s${i + 1}`}>
      <h2>{i + 1}. {s.heading}</h2>
      {s.blocks.map((b) =>
        typeof b === "string" ? <p>{b}</p>
        : "subhead" in b ? <h3>{b.subhead}</h3>
        : "note" in b ? <p class="note">{b.note}</p>
        : <ul>{b.list.map((it) => <li>{it}</li>)}</ul>
      )}
    </section>
  ))}
</article>

<style>
  .legal { padding-block: var(--space-section); max-width: 52rem; }
  .mt { margin-top: var(--space-stack); }
  .toc { margin-block: var(--space-block); padding-block: var(--space-stack); border-block: 1px solid var(--line); }
  .toc ol { padding-left: 1.25rem; display: grid; gap: 0.35rem; }
  section { margin-top: var(--space-block); }
  section > * + * { margin-top: var(--space-stack); }
  section h3 { margin-top: var(--space-stack); }
  section ul { padding-left: 1.25rem; display: grid; gap: 0.5rem; }
  .note { border-left: 3px solid var(--hivis); padding-left: 1rem; }
</style>
