---
import { SITE_NAME, REGION, CONTACT_EMAIL, LINKEDIN_URL, FOOTER_DESCRIPTION } from "../lib/site.js";
const year = new Date().getFullYear();

// Four columns per 07 §4. The link sets are what the site has, nothing more.
const columns = [
  {
    heading: "Explore",
    links: [
      { href: "/commercial", label: "Commercial" },
      { href: "/operations", label: "Operations" },
      { href: "/residential", label: "Residential" },
    ],
  },
  {
    heading: "Understand",
    links: [
      { href: "/work", label: "The work" },
      { href: "/audit", label: "Get your audit" },
    ],
  },
  {
    heading: "Company",
    links: [
      { href: "/", label: SITE_NAME },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="wordmark">{SITE_NAME}</a>
        <p class="steel">{FOOTER_DESCRIPTION}</p>
      </div>
      {
        columns.map((col) => (
          <div>
            <p class="meta footer-heading">{col.heading}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <p class="meta footer-heading">Contact</p>
        <ul>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          {LINKEDIN_URL && <li><a href={LINKEDIN_URL} rel="noopener">LinkedIn</a></li>}
        </ul>
      </div>
    </div>
    <hr class="hairline" />
    <p class="meta footer-bottom">&copy; {year} {SITE_NAME} · {REGION}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-block) var(--space-stack);
    border-top: 1px solid var(--line);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(4, 1fr);
    gap: var(--space-block) var(--space-stack);
    margin-bottom: var(--space-block);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .footer-brand p {
    max-width: 32ch;
  }
  .footer-heading {
    margin-bottom: 0.75rem;
  }
  ul {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  li a {
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  .footer-bottom {
    padding-top: var(--space-stack);
  }
  @media (max-width: 52rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
