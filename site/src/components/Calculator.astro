---
// Concrete section. Sliders with live labels, one big output, one line, a
// button, a footnote. Vanilla script, no library. The formula is chosen by
// name from a small map rather than evaluated from a string, so nothing on
// the page is ever passed to eval.
interface Slider { id: string; label: string; min: number; max: number; step: number; default: number; prefix?: string }
interface Props {
  heading?: string;
  sliders: Slider[];
  formula: "residential";
  outputLine: string;
  footnote: string;
  cta: { label: string; href: string };
}
const { heading = "Run your number.", sliders, formula, outputLine, footnote, cta } = Astro.props;
---

<div class="calc" data-calc data-formula={formula}>
  <h2>{heading}</h2>
  <div class="calc-grid">
    <div class="calc-inputs">
      {sliders.map((s) => (
        <div class="calc-field">
          <div class="calc-label">
            <label for={`calc-${s.id}`}>{s.label}</label>
            <output for={`calc-${s.id}`} data-out={s.id} data-prefix={s.prefix ?? ""}>{s.prefix ?? ""}{s.default.toLocaleString("en-US")}</output>
          </div>
          <input
            type="range"
            id={`calc-${s.id}`}
            name={s.id}
            min={s.min}
            max={s.max}
            step={s.step}
            value={s.default}
            data-slider={s.id}
          />
        </div>
      ))}
    </div>
    <div class="calc-result">
      <p class="calc-number" data-result aria-live="polite">$0</p>
      <p>{outputLine}</p>
      <p class="calc-cta"><a class="btn" href={cta.href}>{cta.label}</a></p>
      <p class="meta">{footnote}</p>
    </div>
  </div>
</div>

<style>
  .calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-block);
    margin-top: var(--space-block);
    align-items: start;
  }
  .calc-inputs {
    display: grid;
    gap: var(--space-stack);
  }
  .calc-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  output {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: 100%;
    accent-color: var(--hivis);
    height: 2rem;
  }
  .calc-number {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-calc);
    line-height: 1;
    letter-spacing: var(--track-h1);
    font-variant-numeric: tabular-nums;
  }
  .calc-result > * + * {
    margin-top: var(--space-stack);
  }
  .calc-result .meta {
    margin-top: var(--space-stack);
  }
  @media (max-width: 52rem) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const formulas: Record<string, (v: Record<string, number>) => number> = {
    // (customers − contacted) × 0.06 × ticket
    residential: (v) => Math.max(0, v.customers - v.contacted) * 0.06 * v.ticket,
  };
  const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });

  document.querySelectorAll<HTMLElement>("[data-calc]").forEach((calc) => {
    const fn = formulas[calc.dataset.formula ?? ""];
    const sliders = calc.querySelectorAll<HTMLInputElement>("[data-slider]");
    const result = calc.querySelector<HTMLElement>("[data-result]");
    function update() {
      const v: Record<string, number> = {};
      sliders.forEach((s) => {
        v[s.dataset.slider!] = Number(s.value);
        const out = calc.querySelector<HTMLElement>(`[data-out="${s.dataset.slider}"]`);
        if (out) out.textContent = (out.dataset.prefix ?? "") + Number(s.value).toLocaleString("en-US");
      });
      if (result && fn) result.textContent = money.format(fn(v));
    }
    sliders.forEach((s) => s.addEventListener("input", update));
    update();
  });
</script>
