---
import StatRow from "./StatRow.astro";
import Quote from "./Quote.astro";
// Left: name, trade · city, one-line result, text link. Right: StatRow.
// Below both: the first quote.
interface Props { entry: any }
const { entry } = Astro.props;
const d = entry.data;
const quote = d.quotes?.[0];
---

<article class="feature">
  <div class="feature-grid">
    <div class="feature-lead">
      <h2 class="h3">{d.name}</h2>
      <p class="meta">{d.trade} · {d.city}</p>
      <p class="h2 result">{d.headlineResult}</p>
      <a href={`/work/${d.slug}`}>Open the case study</a>
    </div>
    <StatRow stats={d.stats} />
  </div>
  {quote && (
    <div class="feature-quote">
      <Quote text={quote.text} name={quote.name} title={quote.title} company={d.name} />
    </div>
  )}
</article>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-block);
    align-items: start;
  }
  .feature-lead > * + * {
    margin-top: 0.75rem;
  }
  .result {
    margin-top: var(--space-stack);
  }
  .feature-lead a {
    display: inline-block;
    margin-top: var(--space-stack);
    font-weight: 500;
  }
  .feature-quote {
    margin-top: var(--space-block);
    padding-top: var(--space-block);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 52rem) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
