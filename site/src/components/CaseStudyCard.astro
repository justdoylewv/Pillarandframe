---
// Paper card, hairline border, radius. Thumbnail on top. The whole card is
// the link.
interface Props { entry: any }
const { entry } = Astro.props;
const d = entry.data;
const q = d.quotes?.[0];
---

<a class="card" href={`/work/${d.slug}`} data-offer={d.offer}>
  <div class="media ratio-16x9 placeholder" data-label={`Image placeholder: ${d.thumb}`}>
    <img src={d.thumb} alt="" loading="lazy" />
  </div>
  <div class="card-body">
    <h3>{d.name}</h3>
    <p class="meta">{d.trade} · {d.city}</p>
    {q && (
      <>
        <p class="card-quote">{q.text}</p>
        <p class="meta">{q.name} · {q.title}</p>
      </>
    )}
  </div>
</a>

<style>
  .card {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    background: var(--paper);
  }
  .card:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .media {
    border-radius: 0;
  }
  .media img {
    position: absolute;
    inset: 0;
  }
  .placeholder {
    position: relative;
  }
  .card-body {
    padding: var(--space-stack);
  }
  .card-body > * + * {
    margin-top: 0.5rem;
  }
  .card-quote {
    margin-top: 1rem;
  }
</style>
