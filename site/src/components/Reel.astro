---
// Muted, inline, autoplaying, looping, captioned, with a poster. 16:9,
// full-bleed within its container, nearly square corners. If the file is not
// there yet the poster carries a visible label so it cannot ship unnoticed.
interface Props {
  src: string;
  poster: string;
  caption?: string;
  captions?: string;
  label?: string;
}
const { src, poster, caption, captions = "", label = "" } = Astro.props;
---

<figure class="reel">
  <div class="media ratio-16x9 placeholder" data-label={label || `Video placeholder: ${src}`}>
    <video muted playsinline autoplay loop preload="metadata" poster={poster}>
      <source src={src} type="video/mp4" />
      {captions && <track kind="captions" srclang="en" label="English" src={captions} default />}
    </video>
  </div>
  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  .reel {
    margin: 0;
  }
  .reel video {
    position: absolute;
    inset: 0;
  }
  .placeholder {
    position: relative;
  }
  figcaption {
    margin-top: 0.75rem;
  }
</style>
