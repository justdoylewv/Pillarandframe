---
import Reel from "./Reel.astro";
// Two-line H1, one-sentence sub, two buttons, then the reel. The H1 and sub
// carry the single load animation on the site.
interface Props {
  title: string;
  /** A second clause set in gold italic, the current site's signature. */
  emphasis?: string;
  sub: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  reelSrc?: string;
  posterSrc?: string;
  reelLabel?: string;
}
const { title, emphasis, sub, primary, secondary, reelSrc, posterSrc = "", reelLabel } = Astro.props;
---

<section class="section hero on-dark">
  <div class="container">
    <h1 class="fade-up">
      <Fragment set:html={title} />
      {emphasis && <> <span class="em">{emphasis}</span></>}
    </h1>
    <p class="hero-sub fade-up">{sub}</p>
    {(primary || secondary) && (
      <div class="btn-row">
        {primary && <a class="btn" href={primary.href}>{primary.label}</a>}
        {secondary && <a class="btn--secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
    )}
    <slot />
    {reelSrc && (
      <div class="hero-reel">
        <Reel src={reelSrc} poster={posterSrc} label={reelLabel} />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding-bottom: var(--space-block);
    background: var(--ink-2);
  }
  /* The emphasis clause takes its own line, as on the current site. */
  .hero h1 :global(.em) {
    display: block;
  }
  .hero :global(.btn) {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .hero-sub {
    max-width: var(--max-prose);
    margin-top: var(--space-stack);
  }
  .btn-row {
    margin-top: var(--space-block);
  }
  .hero-reel {
    margin-top: var(--space-block);
  }
</style>
