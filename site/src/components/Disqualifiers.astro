---
// H2, items with a hairline between, closing line.
interface Props { items: { title: string; body: string }[]; closing?: string; heading?: string }
const { items, closing = "Still here? Good.", heading = "This isn't for everyone." } = Astro.props;
---

<div class="disq">
  <h2>{heading}</h2>
  <ul>
    {items.map((it) => (
      <li>
        <h3>{it.title}</h3>
        <p>{it.body}</p>
      </li>
    ))}
  </ul>
  <p class="closing">{closing}</p>
</div>

<style>
  ul {
    list-style: none;
    margin-top: var(--space-block);
  }
  li {
    padding-block: var(--space-stack);
    border-top: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 1px solid var(--line);
  }
  li p {
    margin-top: 0.5rem;
    max-width: var(--max-prose);
  }
  .closing {
    margin-top: var(--space-stack);
    font-weight: 500;
  }
</style>
