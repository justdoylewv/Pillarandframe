---
// Body 20, ink. Attribution in steel 14. No quotation glyphs, no italics.
interface Props { text: string; name: string; title?: string; company?: string }
const { text, name, title, company } = Astro.props;
const attribution = [name, [title, company].filter(Boolean).join(", ")].filter(Boolean).join(" · ");
---

<figure class="quote">
  <blockquote><p>{text}</p></blockquote>
  <figcaption class="meta">{attribution}</figcaption>
</figure>

<style>
  .quote {
    margin: 0;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-size: var(--fs-quote);
    line-height: 1.45;
    max-width: var(--max-prose);
  }
  figcaption {
    margin-top: 0.75rem;
  }
</style>
