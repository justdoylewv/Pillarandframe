---
// Greyscale marks. Auto-scrolls at 768px and up, wraps statically below.
// Renders nothing with fewer than three logos, and the label only once there
// are five: until then a bare row of three, per 07 §4.
interface Logo { src: string; alt: string; href?: string }
interface Props { logos: Logo[]; label?: string }
const { logos = [], label = "Trusted by contractors across Central Ohio" } = Astro.props;
const show = logos.length >= 3;
const showLabel = logos.length >= 5;
const scroll = logos.length >= 5;
---

{show && (
  <section class="section logo-strip">
    <div class="container">
      {showLabel && <p class="meta">{label}</p>}
      <div class="track" data-scroll={scroll ? "" : undefined}>
        <ul>
          {logos.map((l) => (
            <li>
              {l.href ? <a href={l.href}><img src={l.src} alt={l.alt} width="140" height="32" loading="lazy" /></a> : <img src={l.src} alt={l.alt} width="140" height="32" loading="lazy" />}
            </li>
          ))}
          {scroll && logos.map((l) => (
            <li aria-hidden="true"><img src={l.src} alt="" width="140" height="32" loading="lazy" /></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .logo-strip {
    padding-block: var(--space-block);
  }
  .meta {
    margin-bottom: var(--space-stack);
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-block);
    align-items: center;
  }
  img {
    height: 2rem;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
  }
  @media (min-width: 48rem) {
    .track[data-scroll] {
      overflow: hidden;
    }
    .track[data-scroll] ul {
      flex-wrap: nowrap;
      width: max-content;
      animation: strip 40s linear infinite;
    }
    @keyframes strip {
      to {
        transform: translateX(-50%);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track[data-scroll] ul {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }
  }
</style>
