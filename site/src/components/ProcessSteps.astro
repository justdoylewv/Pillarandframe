---
// Numbered 01 to 0n because it is a literal sequence. One hairline above.
interface Props { steps: { title: string; body: string }[] }
const { steps } = Astro.props;
---

<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <p class="meta">{String(i + 1).padStart(2, "0")}</p>
      <h3>{s.title}</h3>
      <p>{s.body}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-stack);
    border-top: 1px solid var(--line);
    padding-top: var(--space-stack);
  }
  li > * + * {
    margin-top: 0.5rem;
  }
  @media (max-width: 52rem) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-block);
    }
  }
</style>
