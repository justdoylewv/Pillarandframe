---
// Full-bleed still, ink overlay at 60%, H2 in paper, two buttons, a line of
// small text at 70% paper.
interface Props {
  imgSrc: string;
  title: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  footnote?: string;
}
const { imgSrc, title, primary, secondary, footnote = "Fixed deliverables · fixed price · refund if unused" } = Astro.props;
---

<section class="cta-band">
  <div class="cta-media placeholder" data-label={`Image placeholder: ${imgSrc}`}>
    <img src={imgSrc} alt="" width="2400" height="1200" loading="lazy" />
  </div>
  <div class="cta-overlay"></div>
  <div class="container cta-content">
    <h2>{title}</h2>
    <div class="btn-row">
      <a class="btn" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn--secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
    {footnote && <p class="small">{footnote}</p>}
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    padding-block: var(--space-section);
    color: var(--paper);
    background: var(--ink);
    overflow: hidden;
  }
  .cta-media,
  .cta-overlay {
    position: absolute;
    inset: 0;
  }
  .cta-media {
    background: var(--concrete);
    color: var(--steel);
  }
  .cta-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-overlay {
    background: rgba(20, 22, 26, 0.6);
  }
  .cta-content {
    position: relative;
  }
  .cta-content h2 {
    color: var(--paper);
  }
  .btn-row {
    margin-top: var(--space-block);
  }
  .cta-content .btn--secondary {
    border-color: var(--paper);
    color: var(--paper);
  }
  .cta-content .btn--secondary:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .small {
    margin-top: var(--space-stack);
    color: rgba(255, 255, 255, 0.7);
  }
</style>
