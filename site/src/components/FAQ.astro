---
// Native details/summary. One open at a time, by a few lines of script.
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = "The conversation we've had a hundred times." } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
---

<div class="faq" data-faq={uid}>
  <h2>{heading}</h2>
  <div class="faq-list">
    {items.map((it) => (
      <details>
        <summary>{it.q}</summary>
        <p>{it.a}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-list {
    margin-top: var(--space-block);
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    padding-block: var(--space-stack);
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    color: var(--steel);
    flex-shrink: 0;
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    max-width: var(--max-prose);
    padding-bottom: var(--space-stack);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((faq) => {
    const all = faq.querySelectorAll("details");
    all.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) all.forEach((o) => { if (o !== d) o.open = false; });
      });
    });
  });
</script>
