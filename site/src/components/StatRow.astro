---
import StatTile from "./StatTile.astro";
// Four across, two-by-two on mobile.
interface Props { stats: { number: string; label: string }[] }
const { stats } = Astro.props;
---

<div class="stat-row">
  {stats.map((s) => <StatTile number={s.number} label={s.label} />)}
</div>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 52rem) {
    .stat-row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
