---
// One static page, three forms. The query string picks which one shows; with
// no script, commercial shows. Nothing here needs a server.
import Base from "../layouts/Base.astro";
import AuditForm from "../components/AuditForm.astro";
import { AUDIT } from "../lib/copy";
const types = ["commercial", "operations", "residential"] as const;
---

<Base title="Get your audit" description="Free proof audit, a 15-minute call, or your number. Pick the one that fits.">
  <section class="section">
    <div class="container">
      {/* One H1 on the page. Its text follows the panel; without script it
          reads as the commercial heading, which is also the default panel. */}
      <h1 class="fade-up" data-heading data-headings={JSON.stringify(Object.fromEntries(types.map((t) => [t, AUDIT[t].heading])))}>{AUDIT.commercial.heading}</h1>
      {types.map((t, i) => (
        <div data-panel={t} hidden={i !== 0}>
          <p class="steel mt">{AUDIT[t].subline}</p>
          <div class="mt-block"><AuditForm type={t} /></div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .mt { margin-top: var(--space-stack); }
  .mt-block { margin-top: var(--space-block); }
</style>

<script>
  const type = new URLSearchParams(location.search).get("type");
  const valid = ["commercial", "operations", "residential"];
  const want = type && valid.includes(type) ? type : "commercial";
  document.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => { p.hidden = p.dataset.panel !== want; });
  const h1 = document.querySelector<HTMLElement>("[data-heading]");
  if (h1) { const map = JSON.parse(h1.dataset.headings ?? "{}"); if (map[want]) h1.textContent = map[want]; }
</script>
